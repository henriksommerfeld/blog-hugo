:root{--page-max-width:87.5rem;--header-height:138px;--border-radius:3px;--default-spacing:15px;--font-family-sans-serif:'Muli', 'Helvetica Neue', 'Segoe UI', 'Roboto', sans-serif;--font-family-headings:'Muli', 'Helvetica Neue', 'Segoe UI', 'Roboto', sans-serif}.screen-reader-text{display:none}@media speech{.screen-reader-text{display:block}}code{word-wrap:break-word;font-family:fira code,SFMono-Regular,Menlo,Consolas,monospace}p,li{code{padding:0 4px;border-radius:var(--border-radius);background-color:var(--inline-code-bg-color);border:1px solid var(--inline-code-border-color);white-space:pre-wrap;font-size:large;transition:background-color var(--theme-switcher-speed)ease-in,border-color var(--theme-switcher-speed)ease-in}}pre{overflow:auto;padding:1.1em;font-size:1rem;background-color:var(--highlight-bg-color);color:var(--highlight-color);border-left:4px solid var(--accent-color);border-radius:var(--border-radius);line-height:1.55em;transition:background-color var(--theme-switcher-speed)ease-in,border-color var(--theme-switcher-speed)ease-in;code{word-wrap:normal;text-shadow:none;color:unset;background-color:unset;border:unset;&::selection{background:var(--highlight-selection-color);text-shadow:none}}}.highlight .hll{background-color:#ffc}.highlight{background:#fff}.highlight .c{color:green}.highlight .k{color:#00f}.highlight .ch{color:green}.highlight .cm{color:green}.highlight .cp{color:#00f}.highlight .cpf{color:green}.highlight .c1{color:green}.highlight .cs{color:green}.highlight .ge{font-style:italic}.highlight .gh{font-weight:700}.highlight .gp{font-weight:700}.highlight .gs{font-weight:700}.highlight .gu{font-weight:700}.highlight .kc{color:#00f}.highlight .kd{color:#00f}.highlight .kn{color:#00f}.highlight .kp{color:#00f}.highlight .kr{color:#00f}.highlight .kt{color:#2b91af}.highlight .s{color:#a31515}.highlight .nc{color:#2b91af}.highlight .ow{color:#00f}.highlight .sa{color:#a31515}.highlight .sb{color:#a31515}.highlight .sc{color:#a31515}.highlight .dl{color:#a31515}.highlight .sd{color:#a31515}.highlight .s2{color:#a31515}.highlight .se{color:#a31515}.highlight .sh{color:#a31515}.highlight .si{color:#a31515}.highlight .sx{color:#a31515}.highlight .sr{color:#a31515}.highlight .s1{color:#a31515}.highlight .ss{color:#a31515}pre{background-color:transparent;font-size:9pt}.code-expanded-controls{display:none}.highlight{pre{margin-top:0!important}}@media(-webkit-min-device-pixel-ratio:2){.bitmoji{width:200px}}@media(min-device-pixel-ratio:2){.bitmoji{width:200px}}@media(min-resolution:192dpi){.bitmoji{width:200px}}.categories-tags{font-size:1.1rem;margin-top:var(--default-spacing);margin-bottom:var(--default-spacing);display:grid;grid-template-rows:auto auto;grid-row-gap:1em;@media(min-width:64rem){display: unset;}.icon{color:var(--taxonomy-icon-color)}.icon-tag{@media(min-width:64rem){margin-left: 1em;}}}.articles-with-tag,.articles-with-category{article{margin-bottom:2rem}h1{margin-bottom:2rem}}blockquote{font-style:italic;font-family:Georgia,serif;color:var(--blockquote-color);line-height:1.5em;margin:0;display:flex;align-items:center; ::selection { color: var(--background-color); } .fa { font-style: italic; opacity: 0.5; } p { display: inline-block; margin: 0; font-size: 1.2em; line-height: 1.2em; } &::before, &:after { font-family: Georgia, serif; font-weight: 700; font-size: 5em; opacity: 0.5; } &::before { content: open-quote; margin-right: 0.2em; } &::after { content: close-quote; margin-top: 0.5em; }}a{color:var(--link-color);text-decoration:none;transition:color,text-shadow,background var(--link-speed)ease-out,outline var(--link-outline-speed);outline:none;display:inline;background:linear-gradient(to bottom,var(--link-underline) 0%,var(--link-underline) 98%);background-size:0 2px;background-repeat:no-repeat;background-position:0 100%;line-height:normal;&:visited{color:var(--link-color)}&:focus, &:active, &:hover{color:var(--link-focus-color);text-shadow:0 0 1px var(--link-text-shadow-color);text-decoration:none;outline:none;background-size:100% 2px}}.contact-info{ul{list-style:none;padding-left:1em}li{display:flex;margin-bottom:1em;&:before{content:'';display:none}}a div{display:flex;align-items:center}.icon{width:2em;height:2em}}.guide{main{width:100%;padding-right:0}section{display:flex;flex-direction:column}ol{display:block;max-width:100vw;list-style:none;padding:0}li{display:flex;float:left;padding:.5em;border:1px solid #ccc;border-radius:5px;margin-right:1em;margin-bottom:1em;box-shadow:0 0 5px #eee}.shortcut{display:flex;align-items:center;width:15em;font-size:1.3rem;&.multiline{flex-direction:column}}.plus{display:flex;justify-content:center;width:1.2em}.or{margin-left:.5em;margin-right:.5em}.click{padding-left:.2em}.explaination{width:15em;padding-top:.2em}.key{font-family:average sans,sans-serif;color:#2d3748;width:50px;@media print{width: 40px;}height:50px;@media print{height: 40px;}margin:2px;border-width:3px 7px 10px;border-style:solid;border-radius:4px;background:#d3cfcc;border-color:#ece8e4 #dedad6 #c9c4c4;float:left;&.medium{width:70px;@media print{width: 60px;}.keycap{width:56px;@media print{width: 60px;}}}&.large{width:150px;@media print{width: 140px;}.keycap{width:136px;@media print{width: 140px;}}}.keycap{display:flex;justify-content:center;align-items:center;width:36px;@media print{width: 40px;}height:37px;@media print{height: 40px;}font-size:22px;line-height:1;background:#f5f3f1;background:-webkit-linear-gradient(left,#e5e2e1,#f5f3f1,#e5e2e1);background:-moz-linear-gradient(left,#e5e2e1,#f5f3f1,#e5e2e1);background:-ms-linear-gradient(left,#e5e2e1,#f5f3f1,#e5e2e1);background:-o-linear-gradient(left,#e5e2e1,#f5f3f1,#e5e2e1);background:linear-gradient(left,#e5e2e1,#f5f3f1,#e5e2e1);box-shadow:0 0 10px rgba(0,0,0,.15);border-radius:4px;position:relative;svg{font-size:28px}}}}body{font-size:11pt}h1{font-size:1.3em;font-family:var(--font-family-sans-serif)}h2{font-size:1.2em;font-family:var(--font-family-sans-serif)}h3{font-size:1.1em;font-family:var(--font-family-sans-serif)}h4{font-size:1em;font-family:var(--font-family-sans-serif);font-weight:700}img{max-width:100%;object-fit:contain;height:auto}a[href]::after{content:' (' attr(href)')'}.icon{width:22px;height:22px}#page-footer{display:none}#sidebar{display:none}#searchbox-container{display:none}#comments-button-container{display:none}.header-content{display:none}.code-expanded-controls{display:none}.guide{font-size:14pt;h2{margin-top:0}section{page-break-after:always}li{page-break-inside:avoid}.explaination{padding-left:5mm}.icon{font-size:1em;height:1em;width:1em}}.sr-only{font-size:0}.close{display:none}