.side-by-side{display:flex;gap:1em;figure{flex:1}}figure{margin:0;padding-bottom:1em;&.limit-width img{width:40em}&.limit-width-200 img{width:200px}& > a.lightbox-hover{max-width:100%;display:inline-block;position:relative;.keyboard-navigation &:focus{outline:2px solid var(--accent-color)}&.light, &:hover, &:focus{background:0 0;img{position:relative}&::after{content:'';position:absolute;width:100%;height:calc(100% - 4px);top:0;left:0;filter:drop-shadow(0 1px 5px rgba(0,0,0,.7));background-color:transparent;background-image:url(/images/maximize.svg);background-repeat:no-repeat;background-position:50%;background-size:30%;animation:maximizer var(--image-maximizer-speed)ease-out forwards;@media(prefers-reduced-motion:reduce){content: unset;}}}}img{filter:var(--image-filter)}}@keyframes maximizer{0%{background-size:30%;background-color:rgba(0,0,0,.2)}40%{background-size:42%}100%{background-size:40%;background-color:rgba(0,0,0,.1)}}figcaption{padding-left:.3rem;margin-top:.3rem;color:var(--caption-color);p{font-style:italic;font-size:1em;margin:0}h4{margin:0;font-style:normal;color:var(--color)}}.image-border img{margin:0;padding:2px;-webkit-box-shadow:rgba(34,25,25,.4)0 1px 3px;box-shadow:var(--image-border-box-shadow-color)0 1px 3px;background-color:#fff}dialog{border:none;padding:0;max-width:100vw;max-height:100vh;width:100%;height:100%;background:0 0;overflow:hidden;&::backdrop{background:var(--modal-bg-color-for-blur);backdrop-filter:blur(10px)}}.modal-close-button{display:none;position:absolute;align-items:center;color:#fff;top:2rem;right:2rem;background:0 0;border:none;font-size:1.3rem;cursor:pointer;z-index:1;.icon{font-size:2rem}}dialog[open] .modal-close-button{display:flex}#lightbox-loading-container{--spinner-diameter:60px;--spinner-thickness:3px;display:flex;justify-content:center;align-items:center;width:100%;height:100%}#lightbox-loading{display:flex;justify-content:center;align-items:center;align-self:center;position:relative;background:var(--spinner-bg-color);box-shadow:0 0 15px 5px rgba(0,0,0,.5);opacity:1;border-radius:100%;width:calc(var(--spinner-diameter) * 1.5);height:calc(var(--spinner-diameter) * 1.5);cursor:pointer}.spinner{height:var(--spinner-diameter);width:var(--spinner-diameter);position:relative;display:flex;align-items:center;justify-content:center;&::before{content:'';display:block;height:100%;width:100%;animation:rotation 1s linear infinite;border:var(--spinner-thickness)solid var(--spinner-color);border-top-color:transparent;border-radius:100%;background:0 0}}#lightbox-container{&[open]{display:flex}}#lightbox{width:100%;height:100%;display:flex;justify-content:center;align-items:center;overflow:hidden;padding:0;margin:0;transition:transform var(--lightbox-speed)ease-in-out;&.open{cursor:pointer;transform:scale(1)}&.close{transform:scale(0)}img{max-width:100vw;max-height:100vh;box-shadow:0 4px 15px 5px rgba(0,0,0,.6)}}@media(min-width:800px) and (min-height:800px){#lightbox{img{margin:var(--default-spacing);max-width:calc(100vw - 50px);max-height:calc(100vh - 30px)}}}@keyframes rotation{from{transform:rotate(0)}to{transform:rotate(359deg)}}img{max-width:100%;height:auto}.contact-info{ul{list-style:none;padding-left:1em}li{display:flex;margin-bottom:1em;&:before{content:'';display:none}}a div{display:flex;align-items:center}.icon{width:2em;height:2em}}figure img{transition:transform 1s ease-in-out,filter 1s ease-in-out;&.effect{transform:rotate3d(1,1,1,360deg);filter:grayscale(1)}}