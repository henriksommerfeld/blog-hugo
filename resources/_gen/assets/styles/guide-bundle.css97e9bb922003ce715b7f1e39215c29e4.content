.guide{main{width:100%;padding-right:0}section{display:flex;flex-direction:column}ol{display:block;max-width:100vw;list-style:none;padding:0}li{display:flex;float:left;padding:.5em;border:1px solid #ccc;border-radius:5px;margin-right:1em;margin-bottom:1em;box-shadow:0 0 5px #eee}.shortcut{display:flex;align-items:center;width:15em;font-size:1.3rem;&.multiline{flex-direction:column}}.plus{display:flex;justify-content:center;width:1.2em}.or{margin-left:.5em;margin-right:.5em}.click{padding-left:.2em}.explaination{width:15em;padding-top:.2em}.key{font-family:average sans,sans-serif;color:#2d3748;width:50px;@media print{width: 40px;}height:50px;@media print{height: 40px;}margin:2px;border-width:3px 7px 10px;border-style:solid;border-radius:4px;background:#d3cfcc;border-color:#ece8e4 #dedad6 #c9c4c4;float:left;&.medium{width:70px;@media print{width: 60px;}.keycap{width:56px;@media print{width: 60px;}}}&.large{width:150px;@media print{width: 140px;}.keycap{width:136px;@media print{width: 140px;}}}.keycap{display:flex;justify-content:center;align-items:center;width:36px;@media print{width: 40px;}height:37px;@media print{height: 40px;}font-size:22px;line-height:1;background:#f5f3f1;background:-webkit-linear-gradient(left,#e5e2e1,#f5f3f1,#e5e2e1);background:-moz-linear-gradient(left,#e5e2e1,#f5f3f1,#e5e2e1);background:-ms-linear-gradient(left,#e5e2e1,#f5f3f1,#e5e2e1);background:-o-linear-gradient(left,#e5e2e1,#f5f3f1,#e5e2e1);background:linear-gradient(left,#e5e2e1,#f5f3f1,#e5e2e1);box-shadow:0 0 10px rgba(0,0,0,.15);border-radius:4px;position:relative;svg{font-size:28px}}}}